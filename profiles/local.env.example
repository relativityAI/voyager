# Local PostgreSQL (docker compose `docker compose up -d db`)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voyager

# --- Proxy pool (optional) ------------------------------------------------
# Comma-separated proxy URLs used as a pool (fallback when direct
# connections are blocked). Each entry: http://host:port
# PROXY_POOL=http://proxy1.example.com:8080,http://proxy2.example.com:3128
#
# Force the pool to be used from the start (even locally) instead of trying
# a direct connection first. Set to true/1/yes.
# PROXY_POOL_FORCE=false
