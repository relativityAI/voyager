# MongoDB Atlas (M0 free tier). Fill in your cluster credentials:
#   - create a database user (Database Access)
#   - allow your IP (Network Access) or 0.0.0.0/0 for the API host
# Copy this file to profiles/atlas.env and fill in the values.
MONGODB_URL=mongodb+srv://<db_user>:<db_password>@<cluster>.<hash>.mongodb.net/?retryWrites=true&w=majority&appName=<cluster>
MONGODB_DB_NAME=voyager
