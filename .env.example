# MongoDB
MONGODB_URL=mongodb://root:example@localhost:27017/
MONGODB_DB_NAME=voyager

# Server
PORT=8001
ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth — the admin key protects /admin/* (key management) endpoints
VOYAGER_ADMIN_KEY=

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true
LOG_FILE_SINK=

# CORS — comma-separated origins for browser clients; empty disables CORS
CORS_ORIGINS=

# NSE scraping behaviour
NSE_CALLS_PER_SECOND=10
NSE_MAX_XBRL_CONCURRENCY=6

# Async pull jobs
MAX_CONCURRENT_PULLS=2
STALE_JOB_MINUTES=30
