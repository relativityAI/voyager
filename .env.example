# PostgreSQL (Supabase or local)
DATABASE_URL=postgresql+asyncpg://postgres:example@localhost:5432/voyager

# Server
PORT=8001
ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth — the admin key protects /admin/* (key management) endpoints
VOYAGER_ADMIN_KEY=

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true
LOG_FILE_SINK=

# CORS — comma-separated origins for browser clients; empty disables CORS
CORS_ORIGINS=

# NSE scraping behaviour
NSE_CALLS_PER_SECOND=10
NSE_MAX_XBRL_CONCURRENCY=6

# SEC (EDGAR) — required for country=us pulls. UA must declare who is making
# requests ("Name email"); edgartools throttles to 10 req/s internally.
SEC_IDENTITY=
# 10-K filings parsed per SEC pull (used for annual statements and the
# fiscal-year-end quarter derivation); 10-Q filings per quarterly pull.
EDGAR_MAX_ANNUAL_FILINGS=8
EDGAR_MAX_QUARTERLY_FILINGS=40

# NSE proxy (optional)
# Static proxy for NSE requests. When set, overrides the free proxy pool.
# Format: http://user:pass@host:port  or  socks5://host:port
NSE_PROXY=

# Free proxy pool (used when NSE_PROXY is not set)
# On Render: pool is tried first (direct connection known to fail).
# Locally: direct is tried first; pool is fallback on 403/blocked.
NSE_USE_FREE_PROXIES=true

# Async pull jobs
MAX_CONCURRENT_PULLS=2
STALE_JOB_MINUTES=30

# Reddit (social/reddit endpoint via PRAW) — create an app at
# https://www.reddit.com/prefs/apps (script) to obtain these.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# LiteLLM (sentiment/management) — one model, any provider:
#   openai/gpt-4o-mini, anthropic/claude-3-5-sonnet-latest,
#   groq/llama-3.3-70b-versatile, ollama/llama3.1, ...
LITELLM_MODEL=openai/gpt-4o-mini
LITELLM_API_KEY=
LITELLM_API_BASE=
